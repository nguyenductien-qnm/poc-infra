{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["-c", "import runpy,subprocess,sys;from pathlib import Path;root=Path(subprocess.check_output(['git','rev-parse','--show-toplevel'],text=True,timeout=2).strip());sys.argv[0]=str(root/'scripts/verify-pulumi-pack.py');runpy.run_path(sys.argv[0],run_name='__main__')", "--hook", "claude"],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["-c", "import runpy,subprocess,sys;from pathlib import Path;root=Path(subprocess.check_output(['git','rev-parse','--show-toplevel'],text=True,timeout=2).strip());sys.argv[0]=str(root/'scripts/verify-pulumi-pack.py');runpy.run_path(sys.argv[0],run_name='__main__')", "--hook", "claude"],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
