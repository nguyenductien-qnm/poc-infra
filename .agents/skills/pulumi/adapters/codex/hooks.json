{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$(git rev-parse --show-toplevel)/.agents/skills/pulumi/scripts/verify.py\" --hook codex --repo-root \"$(git rev-parse --show-toplevel)\"",
            "commandWindows": "python -c \"import runpy,subprocess,sys;from pathlib import Path;root=Path(subprocess.check_output(['git','rev-parse','--show-toplevel'],text=True,timeout=2).strip());sys.argv[0]=str(root/'.agents/skills/pulumi/scripts/verify.py');sys.argv.extend(['--hook','codex','--repo-root',str(root)]);runpy.run_path(sys.argv[0],run_name='__main__')\"",
            "timeout": 5,
            "additionalContextLimit": 600
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$(git rev-parse --show-toplevel)/.agents/skills/pulumi/scripts/verify.py\" --hook codex --repo-root \"$(git rev-parse --show-toplevel)\"",
            "commandWindows": "python -c \"import runpy,subprocess,sys;from pathlib import Path;root=Path(subprocess.check_output(['git','rev-parse','--show-toplevel'],text=True,timeout=2).strip());sys.argv[0]=str(root/'.agents/skills/pulumi/scripts/verify.py');sys.argv.extend(['--hook','codex','--repo-root',str(root)]);runpy.run_path(sys.argv[0],run_name='__main__')\"",
            "timeout": 5,
            "additionalContextLimit": 600
          }
        ]
      }
    ]
  }
}
